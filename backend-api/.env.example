# Local MongoDB + MongoDB Compass (no auth)
MONGO_URI=mongodb://localhost:27017/book-store
PORT=3001

# Docker Compose MongoDB (docker compose up -d mongo) — use in Compass: root / admin
# MONGO_URI=mongodb://root:admin@localhost:27017/book-store?authSource=admin

# MongoDB Atlas
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/book-store?authSource=admin
